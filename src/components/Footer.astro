---
import { withBase } from "../lib/withBase";

const year = new Date().getFullYear();
const homeHref = withBase("/");

const columns = [
  {
    title: "Explore",
    links: [
      { label: "Tours & trips", href: withBase("/tours/") },
      { label: "Car rental", href: withBase("/car-rental/") },
      { label: "Permits", href: withBase("/permits/") },
      { label: "About us", href: `${homeHref}#about` },
      { label: "Contact", href: `${homeHref}#contact` },
    ],
  },
  {
    title: "Support",
    links: [
      { label: "FAQ", href: withBase("/faq/") },
      { label: "Booking terms", href: withBase("/terms/") },
      // { label: "Insurance", href: `${homeHref}#contact` },
      { label: "Privacy policy", href: withBase("/privacy/") },
    ],
  },
];
---

<footer class="bg-stone-950 text-white">
  <div
    class="mx-auto grid max-w-7xl gap-12 px-6 py-16 sm:grid-cols-2 lg:grid-cols-4"
  >
    <div class="sm:col-span-2">
      <p class="font-display text-2xl font-semibold">Bengo Tours Uganda</p>
      <p class="mt-4 max-w-sm leading-relaxed text-white/60">
        Car rental, guided tours, and gorilla permits across Uganda. Delivered by people who know every road.
      </p>
    </div>
    {
      columns.map((column) => (
        <div>
          <h3 class="text-sm font-semibold uppercase tracking-wider text-white/50">
            {column.title}
          </h3>
          <ul class="mt-4 space-y-3">
            {column.links.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="text-white/80 transition hover:text-white"
                >
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>
  <div class="border-t border-white/10">
    <div
      class="mx-auto flex max-w-7xl flex-col gap-2 px-6 py-6 text-sm text-white/50 sm:flex-row sm:items-center sm:justify-between"
    >
      <p>© {year} Bengo Tours and Travels. All rights reserved.</p>
      <p>Brought to you by <a href={"https://www.linkedin.com/in/iaransay"}> @iaransay</a></p>
    </div>
  </div>
</footer>
