---
import { icons } from "@iconify-json/tabler";
import { getIconData, iconToSVG } from "@iconify/utils";

interface Props {
  /** Tabler icon name, e.g. "map-pin". Browse them at https://tabler.io/icons */
  name: string;
  class?: string;
}

const { name, class: className } = Astro.props;

const data = getIconData(icons, name);
if (!data) throw new Error(`Unknown Tabler icon: "${name}"`);
const { attributes, body } = iconToSVG(data);
---

<svg class={className} {...attributes} aria-hidden="true" set:html={body}></svg>
