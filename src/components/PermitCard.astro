---
import type { Permit } from "../data/permits";

interface Props {
  permit: Permit;
}

const { permit } = Astro.props;
---

<article
  class="reveal flex flex-col rounded-2xl bg-white p-8 shadow-sm ring-1 ring-stone-200 transition hover:shadow-xl"
>
  <div class="flex items-start justify-between gap-4">
    <span
      class="flex h-12 w-12 shrink-0 items-center justify-center rounded-2xl bg-brand-50 text-brand-600"
    >
      <svg
        class="h-6 w-6"
        fill="none"
        viewBox="0 0 24 24"
        stroke-width="1.6"
        stroke="currentColor"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d={permit.icon}></path>
      </svg>
    </span>
    <span
      class="rounded-full bg-stone-100 px-3 py-1 text-xs font-semibold text-stone-600"
    >
      {permit.park}
    </span>
  </div>
  <h3 class="mt-6 font-display text-xl font-semibold text-stone-900">
    {permit.name}
  </h3>
  <p class="mt-2 flex-1 text-sm leading-relaxed text-stone-600">
    {permit.blurb}
  </p>
  <dl class="mt-6 space-y-2 text-sm">
    <div class="flex items-baseline justify-between gap-4">
      <dt class="text-stone-500">Time with wildlife</dt>
      <dd class="text-right font-medium text-stone-900">{permit.duration}</dd>
    </div>
  </dl>
  <div
    class="mt-6 flex items-center justify-between border-t border-stone-100 pt-6"
  >
    <p class="text-sm text-stone-500">
      <span class="text-2xl font-bold text-stone-900">
        ${permit.price.toLocaleString("en-US")}
      </span>
      <span class="ml-1">per person</span>
    </p>
    <a
      href="#contact"
      class="rounded-full bg-stone-900 px-5 py-2 text-sm font-semibold text-white transition hover:bg-brand-600"
    >
      Request
    </a>
  </div>
</article>
