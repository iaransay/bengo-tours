---
import { permitBookingSteps } from "../data/permits";
---

<div class="reveal rounded-3xl bg-stone-950 px-8 py-14 text-white sm:px-14">
  <h3 class="font-display text-3xl font-semibold">How booking works</h3>
  <p class="mt-3 max-w-2xl leading-relaxed text-white/70">
    Permits are the one part of a Uganda trip you cannot leave until the last
    minute. Here is how we handle it.
  </p>
  <ol class="mt-12 grid gap-10 sm:grid-cols-2 lg:grid-cols-4">
    {
      permitBookingSteps.map((step, index) => (
        <li>
          <span class="font-display text-4xl font-semibold text-accent-300">
            {String(index + 1).padStart(2, "0")}
          </span>
          <h4 class="mt-3 font-semibold text-white">{step.title}</h4>
          <p class="mt-2 text-sm leading-relaxed text-white/60">{step.text}</p>
        </li>
      ))
    }
  </ol>
</div>
