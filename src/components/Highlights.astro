---
import Icon from "./Icon.astro";
import { clockIcon, mapPinIcon, sealPercentIcon } from "../lib/icons";

const highlights = [
  {
    title: "Local expert guides",
    text: "Every trip is led by people who call the destination home.",
    icon: mapPinIcon,
  },
  {
    title: "Flexible booking",
    text: "Free rescheduling up to 48 hours before departure.",
    icon: clockIcon,
  },
  // {
  //   title: "Fully insured fleet",
  //   text: "Modern vehicles with full coverage and 24/7 roadside assistance.",
  // },
  {
    title: "Best price promise",
    text: "Find it cheaper elsewhere and we match it, no questions asked.",
    icon: sealPercentIcon,
  },
];
---

<section class="border-b border-stone-200 bg-white">
  <div
    class="mx-auto grid max-w-7xl grid-cols-1 gap-10 px-6 py-16 sm:grid-cols-2 lg:grid-cols-4"
  >
    {
      highlights.map((item) => (
        <div class="reveal flex gap-4">
          <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-2xl bg-brand-50 text-brand-600">
            <Icon icon={item.icon} class="h-6 w-6" />
          </div>
          <div>
            <h3 class="font-semibold text-stone-900">{item.title}</h3>
            <p class="mt-1 text-sm leading-relaxed text-stone-600">
              {item.text}
            </p>
          </div>
        </div>
      ))
    }
  </div>
</section>
