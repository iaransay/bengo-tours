---
const highlights = [
  {
    title: "Local expert guides",
    text: "Every trip is led by people who call the destination home.",
    icon: "M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Zm4.5 0c0 7-7.5 11.25-7.5 11.25S4.5 17.5 4.5 10.5a7.5 7.5 0 1 1 15 0Z",
  },
  {
    title: "Flexible booking",
    text: "Free rescheduling up to 48 hours before departure.",
    icon: "M12 6v6h4.5m4.5 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z",
  },
  {
    title: "Fully insured fleet",
    text: "Modern vehicles with full coverage and 24/7 roadside assistance.",
    icon: "M9 12.75 11.25 15 15 9.75m-3-7.036A11.96 11.96 0 0 1 3.6 6c-.1.68-.1 1.36-.1 2.05 0 5.6 3.6 10.35 8.5 12.05 4.9-1.7 8.5-6.45 8.5-12.05 0-.69 0-1.37-.1-2.05a11.96 11.96 0 0 1-8.4-3.286Z",
  },
  {
    title: "Best price promise",
    text: "Find it cheaper elsewhere and we match it, no questions asked.",
    icon: "M11.25 11.25l.041-.02a.75.75 0 0 1 1.063.852l-.708 2.836a.75.75 0 0 0 1.063.853l.041-.021M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Zm-9-3.75h.008v.008H12V8.25Z",
  },
];
---

<section class="border-b border-stone-200 bg-white">
  <div
    class="mx-auto grid max-w-7xl grid-cols-1 gap-10 px-6 py-16 sm:grid-cols-2 lg:grid-cols-4"
  >
    {
      highlights.map((item) => (
        <div class="reveal flex gap-4">
          <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-2xl bg-brand-50 text-brand-600">
            <svg
              class="h-6 w-6"
              fill="none"
              viewBox="0 0 24 24"
              stroke-width="1.6"
              stroke="currentColor"
            >
              <path stroke-linecap="round" stroke-linejoin="round" d={item.icon} />
            </svg>
          </div>
          <div>
            <h3 class="font-semibold text-stone-900">{item.title}</h3>
            <p class="mt-1 text-sm leading-relaxed text-stone-600">
              {item.text}
            </p>
          </div>
        </div>
      ))
    }
  </div>
</section>
