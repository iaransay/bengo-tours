---
import { Image } from "astro:assets";
import { carPath, formatDailyRate, type Car } from "../data/cars";
import { withBase } from "../lib/withBase";
import Icon from "./Icon.astro";
import { gearIcon, suitcaseIcon, usersIcon } from "../lib/icons";

interface Props {
  car: Car;
}

const { car } = Astro.props;
const hasGallery = car.images.length > 1;
const detailsHref = withBase(carPath(car));
const selfDriveRate = formatDailyRate(car.pricePerDay);
const driverRate = formatDailyRate(car.pricePerDayWithDriver);
---

<article
  class="reveal group overflow-hidden rounded-2xl bg-white shadow-sm ring-1 ring-stone-200 transition hover:shadow-xl"
>
  <button
    type="button"
    class="car-gallery-trigger relative block aspect-[16/10] w-full overflow-hidden text-left"
    aria-haspopup="dialog"
    aria-label={`View photos of ${car.model}`}
  >
    <Image
      src={car.images[0]}
      alt={`${car.model} rental car in Uganda`}
      widths={[400, 640, 800, 1200]}
      sizes="(min-width: 1280px) 400px, (min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw"
      class="h-full w-full object-cover transition duration-500 group-hover:scale-105"
    />
    <span
      class="absolute left-4 top-4 rounded-full bg-white/90 px-3 py-1 text-xs font-semibold text-stone-800 backdrop-blur"
    >
      {car.category}
    </span>
    {
      hasGallery && (
        <span class="absolute right-4 top-4 flex items-center gap-1.5 rounded-full bg-stone-950/70 px-3 py-1 text-xs font-semibold text-white backdrop-blur">
          <svg
            class="h-3.5 w-3.5"
            fill="none"
            viewBox="0 0 24 24"
            stroke-width="1.8"
            stroke="currentColor"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M6.827 6.175A2.31 2.31 0 0 1 5.186 7.23c-.38.054-.757.112-1.132.174-1.234.201-2.104 1.313-2.104 2.567v9.176c0 1.354 1.097 2.453 2.45 2.453h15.2c1.353 0 2.45-1.1 2.45-2.453V9.97c0-1.254-.87-2.366-2.104-2.567a48.11 48.11 0 0 0-1.132-.174 2.31 2.31 0 0 1-1.64-1.055l-.822-1.316a2.192 2.192 0 0 0-1.736-1.039 48.774 48.774 0 0 0-4.665 0 2.192 2.192 0 0 0-1.736 1.04l-.821 1.316Z"
            />
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M16.5 12.75a4.5 4.5 0 1 1-9 0 4.5 4.5 0 0 1 9 0Z"
            />
          </svg>
          {car.images.length} photos
        </span>
      )
    }
  </button>
  <div class="p-6">
    <h3 class="font-display text-xl font-semibold text-stone-900">
      <a href={detailsHref} class="transition hover:text-brand-600">
        {car.model}
      </a>
    </h3>
    <ul class="mt-4 flex flex-wrap gap-x-5 gap-y-2 text-sm text-stone-600">
      <li class="flex items-center gap-1.5">
        <Icon icon={usersIcon} class="h-4 w-4 text-stone-400" />
        {car.seats} seats
      </li>
      <li class="flex items-center gap-1.5">
        <Icon icon={gearIcon} class="h-4 w-4 text-stone-400" />
        {car.transmission}
      </li>
      <li class="flex items-center gap-1.5">
        <Icon icon={suitcaseIcon} class="h-4 w-4 text-stone-400" />
        {car.luggage} bags
      </li>
    </ul>
    <div class="mt-5 flex items-end justify-between border-t border-stone-100 pt-5">
      <div>
        {
          selfDriveRate || driverRate ? (
            <>
              {selfDriveRate && (
                <p class="text-sm text-stone-500">
                  <span class="text-lg font-bold text-stone-900">
                    {selfDriveRate}
                  </span>
                  /day self-drive
                </p>
              )}
              {driverRate && (
                <p class="mt-0.5 text-xs text-stone-500">
                  {driverRate}/day with driver
                </p>
              )}
            </>
          ) : (
            <>
              <p class="text-sm font-semibold text-stone-900">
                Rates on request
              </p>
              <p class="mt-0.5 text-xs text-stone-500">
                Self-drive or with driver
              </p>
            </>
          )
        }
      </div>
      <div class="flex items-center gap-4">
        <a
          href={detailsHref}
          class="text-sm font-semibold text-stone-600 transition hover:text-brand-600"
        >
          Details
        </a>
        <a
          href="#contact"
          class="rounded-full bg-stone-900 px-5 py-2 text-sm font-semibold text-white transition hover:bg-brand-600"
        >
          Reserve
        </a>
      </div>
    </div>
  </div>

  <dialog class="car-gallery-dialog m-auto w-full max-w-3xl rounded-3xl bg-stone-950 p-0 backdrop:bg-stone-950/80">
    <div class="relative">
      <button
        type="button"
        class="car-gallery-close absolute right-4 top-4 z-10 flex h-10 w-10 items-center justify-center rounded-full bg-white/10 text-white backdrop-blur transition hover:bg-white/20"
        aria-label="Close gallery"
      >
        <svg
          class="h-5 w-5"
          fill="none"
          viewBox="0 0 24 24"
          stroke-width="2"
          stroke="currentColor"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M6 18 18 6M6 6l12 12"></path>
        </svg>
      </button>
      <div
        class="car-gallery-track flex snap-x snap-mandatory overflow-x-auto [scrollbar-width:none] [&::-webkit-scrollbar]:hidden"
      >
        {
          car.images.map((src, index) => (
            <Image
              src={src}
              alt={`${car.model}, photo ${index + 1} of ${car.images.length}`}
              widths={[640, 768, 1152, 1536]}
              sizes="(min-width: 768px) 768px, 100vw"
              class="aspect-[4/3] w-full shrink-0 snap-center object-cover sm:aspect-[16/10]"
            />
          ))
        }
      </div>
      {
        hasGallery && (
          <>
            <button
              type="button"
              class="car-gallery-prev absolute left-4 top-1/2 flex h-11 w-11 -translate-y-1/2 items-center justify-center rounded-full bg-white/10 text-white backdrop-blur transition hover:bg-white/20"
              aria-label="Previous photo"
            >
              <svg
                class="h-5 w-5"
                fill="none"
                viewBox="0 0 24 24"
                stroke-width="2"
                stroke="currentColor"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M15.75 19.5 8.25 12l7.5-7.5"
                />
              </svg>
            </button>
            <button
              type="button"
              class="car-gallery-next absolute right-4 top-1/2 flex h-11 w-11 -translate-y-1/2 items-center justify-center rounded-full bg-white/10 text-white backdrop-blur transition hover:bg-white/20"
              aria-label="Next photo"
            >
              <svg
                class="h-5 w-5"
                fill="none"
                viewBox="0 0 24 24"
                stroke-width="2"
                stroke="currentColor"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="m8.25 4.5 7.5 7.5-7.5 7.5"
                />
              </svg>
            </button>
          </>
        )
      }
    </div>
    <p class="px-6 py-5 text-center font-display text-lg font-semibold text-white">
      {car.model}
    </p>
  </dialog>
</article>

<script>
  const findDialog = (el: HTMLElement) =>
    el.closest("article")?.querySelector<HTMLDialogElement>(
      ".car-gallery-dialog"
    );

  const scrollToSlide = (track: HTMLElement, direction: -1 | 1) => {
    const slideWidth =
      track.firstElementChild instanceof HTMLElement
        ? track.firstElementChild.offsetWidth
        : 0;
    track.scrollBy({ left: direction * slideWidth, behavior: "smooth" });
  };

  document.addEventListener("click", (event) => {
    const target = event.target as HTMLElement;

    const trigger = target.closest<HTMLElement>(".car-gallery-trigger");
    if (trigger) {
      findDialog(trigger)?.showModal();
      return;
    }

    const closeButton = target.closest<HTMLElement>(".car-gallery-close");
    if (closeButton) {
      closeButton.closest("dialog")?.close();
      return;
    }

    const dialog = target.closest<HTMLDialogElement>(".car-gallery-dialog");
    if (dialog && target === dialog) {
      dialog.close();
      return;
    }

    const prevButton = target.closest<HTMLElement>(".car-gallery-prev");
    const nextButton = target.closest<HTMLElement>(".car-gallery-next");
    if (!prevButton && !nextButton) return;

    const track = target
      .closest(".car-gallery-dialog")
      ?.querySelector<HTMLElement>(".car-gallery-track");
    if (track) scrollToSlide(track, prevButton ? -1 : 1);
  });

  document.addEventListener("keydown", (event) => {
    const openDialog = document.querySelector<HTMLDialogElement>(
      ".car-gallery-dialog[open]"
    );
    if (!openDialog || (event.key !== "ArrowLeft" && event.key !== "ArrowRight"))
      return;

    const track = openDialog.querySelector<HTMLElement>(".car-gallery-track");
    if (track) scrollToSlide(track, event.key === "ArrowLeft" ? -1 : 1);
  });
</script>
