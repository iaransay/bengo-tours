---
import type { Car } from "../data/cars";
import { withBase } from "../lib/withBase";

interface Props {
  car: Car;
}

const { car } = Astro.props;
const hasGallery = car.images.length > 1;
---

<article
  class="reveal group overflow-hidden rounded-2xl bg-white shadow-sm ring-1 ring-stone-200 transition hover:shadow-xl"
>
  <button
    type="button"
    class="car-gallery-trigger relative block aspect-[16/10] w-full overflow-hidden text-left"
    aria-haspopup="dialog"
    aria-label={`View photos of ${car.model}`}
  >
    <img
      src={withBase(car.images[0])}
      alt={car.model}
      loading="lazy"
      class="h-full w-full object-cover transition duration-500 group-hover:scale-105"
    />
    <span
      class="absolute left-4 top-4 rounded-full bg-white/90 px-3 py-1 text-xs font-semibold text-stone-800 backdrop-blur"
    >
      {car.category}
    </span>
    {
      hasGallery && (
        <span class="absolute right-4 top-4 flex items-center gap-1.5 rounded-full bg-stone-950/70 px-3 py-1 text-xs font-semibold text-white backdrop-blur">
          <svg
            class="h-3.5 w-3.5"
            fill="none"
            viewBox="0 0 24 24"
            stroke-width="1.8"
            stroke="currentColor"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M6.827 6.175A2.31 2.31 0 0 1 5.186 7.23c-.38.054-.757.112-1.132.174-1.234.201-2.104 1.313-2.104 2.567v9.176c0 1.354 1.097 2.453 2.45 2.453h15.2c1.353 0 2.45-1.1 2.45-2.453V9.97c0-1.254-.87-2.366-2.104-2.567a48.11 48.11 0 0 0-1.132-.174 2.31 2.31 0 0 1-1.64-1.055l-.822-1.316a2.192 2.192 0 0 0-1.736-1.039 48.774 48.774 0 0 0-4.665 0 2.192 2.192 0 0 0-1.736 1.04l-.821 1.316Z"
            />
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M16.5 12.75a4.5 4.5 0 1 1-9 0 4.5 4.5 0 0 1 9 0Z"
            />
          </svg>
          {car.images.length} photos
        </span>
      )
    }
  </button>
  <div class="p-6">
    <h3 class="font-display text-xl font-semibold text-stone-900">
      {car.model}
    </h3>
    <ul class="mt-4 flex flex-wrap gap-x-5 gap-y-2 text-sm text-stone-600">
      <li class="flex items-center gap-1.5">
        <svg
          class="h-4 w-4 text-stone-400"
          fill="none"
          viewBox="0 0 24 24"
          stroke-width="1.8"
          stroke="currentColor"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M15 19.128a9.38 9.38 0 0 0 2.625.372 9.337 9.337 0 0 0 4.121-.952 4.125 4.125 0 0 0-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 0 1 8.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0 1 11.964-3.07M12 6.375a3.375 3.375 0 1 1-6.75 0 3.375 3.375 0 0 1 6.75 0Zm8.25 2.25a2.625 2.625 0 1 1-5.25 0 2.625 2.625 0 0 1 5.25 0Z"
          ></path>
        </svg>
        {car.seats} seats
      </li>
      <li class="flex items-center gap-1.5">
        <svg
          class="h-4 w-4 text-stone-400"
          fill="none"
          viewBox="0 0 24 24"
          stroke-width="1.8"
          stroke="currentColor"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M9.594 3.94c.09-.542.56-.94 1.11-.94h2.593c.55 0 1.02.398 1.11.94l.213 1.281c.063.374.313.686.645.87.074.04.147.083.22.127.325.196.72.257 1.075.124l1.217-.456a1.125 1.125 0 0 1 1.37.49l1.296 2.247a1.125 1.125 0 0 1-.26 1.431l-1.003.827c-.293.24-.438.613-.43.992a7.723 7.723 0 0 1 0 .255c-.008.378.137.75.43.991l1.004.827c.424.35.534.955.26 1.43l-1.298 2.247a1.125 1.125 0 0 1-1.369.491l-1.217-.456c-.355-.133-.75-.072-1.076.124a6.47 6.47 0 0 1-.22.128c-.331.183-.581.495-.644.869l-.213 1.281c-.09.543-.56.94-1.11.94h-2.594c-.55 0-1.019-.398-1.11-.94l-.213-1.281c-.062-.374-.312-.686-.644-.87a6.52 6.52 0 0 1-.22-.127c-.325-.196-.72-.257-1.076-.124l-1.217.456a1.125 1.125 0 0 1-1.369-.49l-1.297-2.247a1.125 1.125 0 0 1 .26-1.431l1.004-.827c.292-.24.437-.613.43-.992a7.723 7.723 0 0 1 0-.255c.007-.378-.138-.75-.43-.991l-1.004-.827a1.125 1.125 0 0 1-.26-1.43l1.297-2.247a1.125 1.125 0 0 1 1.37-.491l1.216.456c.356.133.751.072 1.076-.124.072-.044.146-.086.22-.128.332-.183.582-.495.644-.869l.214-1.28Z"
          ></path>
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z"></path>
        </svg>
        {car.transmission}
      </li>
      <li class="flex items-center gap-1.5">
        <svg
          class="h-4 w-4 text-stone-400"
          fill="none"
          viewBox="0 0 24 24"
          stroke-width="1.8"
          stroke="currentColor"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M20.25 7.5l-.625 10.632a2.25 2.25 0 0 1-2.247 2.118H6.622a2.25 2.25 0 0 1-2.247-2.118L3.75 7.5m8.25 3v6.75m0 0-3-3m3 3 3-3M3.375 7.5h17.25c.621 0 1.125-.504 1.125-1.125v-1.5c0-.621-.504-1.125-1.125-1.125H3.375c-.621 0-1.125.504-1.125 1.125v1.5c0 .621.504 1.125 1.125 1.125Z"
          ></path>
        </svg>
        {car.luggage} bags
      </li>
    </ul>
    <div class="mt-5 flex items-center justify-between border-t border-stone-100 pt-5">
      <p class="text-sm text-stone-500">
        <span class="text-lg font-bold text-stone-900">${car.pricePerDay}</span>
        /day
      </p>
      <a
        href="#contact"
        class="rounded-full bg-stone-900 px-5 py-2 text-sm font-semibold text-white transition hover:bg-brand-600"
      >
        Reserve
      </a>
    </div>
  </div>

  <dialog class="car-gallery-dialog m-auto w-full max-w-3xl rounded-3xl bg-stone-950 p-0 backdrop:bg-stone-950/80">
    <div class="relative">
      <button
        type="button"
        class="car-gallery-close absolute right-4 top-4 z-10 flex h-10 w-10 items-center justify-center rounded-full bg-white/10 text-white backdrop-blur transition hover:bg-white/20"
        aria-label="Close gallery"
      >
        <svg
          class="h-5 w-5"
          fill="none"
          viewBox="0 0 24 24"
          stroke-width="2"
          stroke="currentColor"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M6 18 18 6M6 6l12 12"></path>
        </svg>
      </button>
      <div
        class="car-gallery-track flex snap-x snap-mandatory overflow-x-auto [scrollbar-width:none] [&::-webkit-scrollbar]:hidden"
      >
        {
          car.images.map((src) => (
            <img
              src={withBase(src)}
              alt={car.model}
              loading="lazy"
              class="aspect-[4/3] w-full shrink-0 snap-center object-cover sm:aspect-[16/10]"
            />
          ))
        }
      </div>
      {
        hasGallery && (
          <>
            <button
              type="button"
              class="car-gallery-prev absolute left-4 top-1/2 flex h-11 w-11 -translate-y-1/2 items-center justify-center rounded-full bg-white/10 text-white backdrop-blur transition hover:bg-white/20"
              aria-label="Previous photo"
            >
              <svg
                class="h-5 w-5"
                fill="none"
                viewBox="0 0 24 24"
                stroke-width="2"
                stroke="currentColor"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M15.75 19.5 8.25 12l7.5-7.5"
                />
              </svg>
            </button>
            <button
              type="button"
              class="car-gallery-next absolute right-4 top-1/2 flex h-11 w-11 -translate-y-1/2 items-center justify-center rounded-full bg-white/10 text-white backdrop-blur transition hover:bg-white/20"
              aria-label="Next photo"
            >
              <svg
                class="h-5 w-5"
                fill="none"
                viewBox="0 0 24 24"
                stroke-width="2"
                stroke="currentColor"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="m8.25 4.5 7.5 7.5-7.5 7.5"
                />
              </svg>
            </button>
          </>
        )
      }
    </div>
    <p class="px-6 py-5 text-center font-display text-lg font-semibold text-white">
      {car.model}
    </p>
  </dialog>
</article>
