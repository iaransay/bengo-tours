---
import TourCard from "./TourCard.astro";
import ComboDeal from "./ComboDeal.astro";
import { comboDeals, tours } from "../data/tours";
import { withBase } from "../lib/withBase";
---

<section id="tours" class="bg-stone-50 py-24">
  <div class="mx-auto max-w-7xl px-6">
    <div class="reveal max-w-2xl">
      <p
        class="text-sm font-semibold uppercase tracking-[0.25em] text-brand-600"
      >
        Tours & trips
      </p>
      <h2
        class="mt-3 font-display text-4xl font-semibold text-stone-900 sm:text-5xl"
      >
        Unforgettable adventures, from Kampala to the wild
      </h2>
      <p class="mt-4 text-lg leading-relaxed text-stone-600">
        Gorillas in Bwindi, the roar of Murchison Falls, chimpanzees in Kibale.
        Pick a ready-made itinerary from Kampala, or ask us to tailor one
        around you.
      </p>
    </div>
    <div
      class="mt-14 grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-3"
    >
      {tours.map((tour) => <TourCard tour={tour} />)}
    </div>
    {comboDeals.map((combo) => <ComboDeal combo={combo} class="mt-8" />)}
    <a
      href={withBase("/tours/")}
      class="reveal mt-10 inline-flex text-sm font-semibold text-brand-600 transition hover:text-brand-500"
    >
      All tours, day-by-day itineraries and what's included →
    </a>
  </div>
</section>
