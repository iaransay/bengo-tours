---
import PermitBookingSteps from "./PermitBookingSteps.astro";
import Icon from "./Icon.astro";
import { permitPath, permitRatesNote, permits } from "../data/permits";
import { withBase } from "../lib/withBase";
---

<section id="permits" class="bg-stone-50 py-24">
  <div class="mx-auto max-w-7xl px-6">
    <div class="reveal max-w-2xl">
      <p
        class="text-sm font-semibold uppercase tracking-[0.25em] text-brand-600"
      >
        Permits
      </p>
      <h2
        class="mt-3 font-display text-4xl font-semibold text-stone-900 sm:text-5xl"
      >
        Uganda Wildlife Authority permits
      </h2>
      <p class="mt-4 text-lg leading-relaxed text-stone-600">
        Gorillas, chimpanzees and golden monkeys can only be tracked with a
        permit issued by the Uganda Wildlife Authority. We secure yours, put it
        in your name, and build the driving days around it.
      </p>
    </div>

    <div
      class="reveal mt-14 divide-y divide-stone-200 overflow-hidden rounded-3xl bg-white ring-1 ring-stone-200"
    >
      {
        permits.map((permit) => (
          <div class="flex flex-col gap-4 p-6 sm:flex-row sm:items-center sm:justify-between sm:gap-8 sm:p-8">
            <div class="flex items-start gap-4">
              <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-2xl bg-brand-50 text-brand-600">
                <Icon name={permit.icon} class="h-6 w-6" />
              </span>
              <div>
                <div class="flex flex-wrap items-center gap-2">
                  <h3 class="font-display text-lg font-semibold text-stone-900">
                    <a
                      href={withBase(permitPath(permit))}
                      class="transition hover:text-brand-600"
                    >
                      {permit.name}
                    </a>
                  </h3>
                  <span class="rounded-full bg-stone-100 px-2.5 py-0.5 text-xs font-semibold text-stone-600">
                    {permit.park}
                  </span>
                </div>
                <p class="mt-1 max-w-xl text-sm leading-relaxed text-stone-600">
                  {permit.blurb}
                </p>
                <p class="mt-2 text-xs font-medium uppercase tracking-wide text-stone-400">
                  {permit.duration}
                </p>
              </div>
            </div>
            <div class="flex shrink-0 items-center justify-between gap-6 sm:flex-col sm:items-end sm:justify-start sm:gap-1">
              <p class="text-xl font-bold text-stone-900">
                From ${permit.price.toLocaleString("en-US")}
                <span class="ml-1 text-sm font-normal text-stone-500">
                  / person
                </span>
              </p>
              <div class="flex items-center gap-4">
                <a
                  href={withBase(permitPath(permit))}
                  class="text-sm font-semibold text-stone-600 transition hover:text-brand-600"
                >
                  Guide
                </a>
                <a
                  href="#contact"
                  class="text-sm font-semibold text-brand-600 transition hover:text-brand-500"
                >
                  Request →
                </a>
              </div>
            </div>
          </div>
        ))
      }
    </div>

    <a
      href={withBase("/permits/")}
      class="reveal mt-8 inline-flex text-sm font-semibold text-brand-600 transition hover:text-brand-500"
    >
      Permit guides: Bwindi sectors, getting there and what to bring →
    </a>

    <div class="mt-20">
      <PermitBookingSteps />
    </div>

    <p class="reveal mt-8 max-w-3xl text-sm leading-relaxed text-stone-500">
      {permitRatesNote}
    </p>
  </div>
</section>
