---
const contactChannels = [
  {
    label: "Call us",
    value: "+34 600 123 456",
    href: "tel:+34600123456",
    icon: "M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 0 0 2.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 0 1-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 0 0-1.091-.852H4.5A2.25 2.25 0 0 0 2.25 4.5v2.25Z",
  },
  {
    label: "Email",
    value: "hello@terraventura.travel",
    href: "mailto:hello@terraventura.travel",
    icon: "M21.75 6.75v10.5a2.25 2.25 0 0 1-2.25 2.25h-15a2.25 2.25 0 0 1-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0 0 19.5 4.5h-15a2.25 2.25 0 0 0-2.25 2.25m19.5 0v.243a2.25 2.25 0 0 1-1.07 1.916l-7.5 4.615a2.25 2.25 0 0 1-2.36 0L3.32 8.91a2.25 2.25 0 0 1-1.07-1.916V6.75",
  },
  {
    label: "Visit us",
    value: "Calle del Sol 24, Madrid",
    href: "https://maps.google.com/?q=Calle+del+Sol+24+Madrid",
    icon: "M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Zm4.5 0c0 7-7.5 11.25-7.5 11.25S4.5 17.5 4.5 10.5a7.5 7.5 0 1 1 15 0Z",
  },
];
---

<section id="contact" class="bg-white py-24">
  <div class="mx-auto grid max-w-7xl gap-16 px-6 lg:grid-cols-5">
    <div class="reveal lg:col-span-2">
      <p
        class="text-sm font-semibold uppercase tracking-[0.25em] text-brand-600"
      >
        Contact
      </p>
      <h2
        class="mt-3 font-display text-4xl font-semibold text-stone-900 sm:text-5xl"
      >
        Let's plan your next trip
      </h2>
      <p class="mt-4 text-lg leading-relaxed text-stone-600">
        Tell us where you dream of going or which car you need, and we'll get
        back to you within one business day.
      </p>
      <ul class="mt-10 space-y-6">
        {
          contactChannels.map((channel) => (
            <li>
              <a href={channel.href} class="group flex items-center gap-4">
                <span class="flex h-12 w-12 items-center justify-center rounded-2xl bg-brand-50 text-brand-600 transition group-hover:bg-brand-600 group-hover:text-white">
                  <svg
                    class="h-6 w-6"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke-width="1.6"
                    stroke="currentColor"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      d={channel.icon}
                    />
                  </svg>
                </span>
                <span>
                  <span class="block text-sm text-stone-500">
                    {channel.label}
                  </span>
                  <span class="block font-semibold text-stone-900">
                    {channel.value}
                  </span>
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
    <form
      id="contact-form"
      class="reveal rounded-3xl bg-stone-50 p-8 ring-1 ring-stone-200 sm:p-10 lg:col-span-3"
    >
      <div class="grid gap-6 sm:grid-cols-2">
        <label class="block">
          <span class="text-sm font-medium text-stone-700">Full name</span>
          <input
            type="text"
            name="name"
            required
            placeholder="Jane Doe"
            class="mt-2 w-full rounded-xl border-0 bg-white px-4 py-3 text-stone-900 shadow-sm ring-1 ring-stone-200 placeholder:text-stone-400 focus:outline-none focus:ring-2 focus:ring-brand-500"
          />
        </label>
        <label class="block">
          <span class="text-sm font-medium text-stone-700">Email</span>
          <input
            type="email"
            name="email"
            required
            placeholder="jane@example.com"
            class="mt-2 w-full rounded-xl border-0 bg-white px-4 py-3 text-stone-900 shadow-sm ring-1 ring-stone-200 placeholder:text-stone-400 focus:outline-none focus:ring-2 focus:ring-brand-500"
          />
        </label>
        <label class="block">
          <span class="text-sm font-medium text-stone-700">I'm interested in</span>
          <select
            name="interest"
            class="mt-2 w-full rounded-xl border-0 bg-white px-4 py-3 text-stone-900 shadow-sm ring-1 ring-stone-200 focus:outline-none focus:ring-2 focus:ring-brand-500"
          >
            <option>A tour or trip</option>
            <option>Renting a car</option>
            <option>A custom itinerary</option>
          </select>
        </label>
        <label class="block">
          <span class="text-sm font-medium text-stone-700">Travel dates</span>
          <input
            type="text"
            name="dates"
            placeholder="June 10 – 17"
            class="mt-2 w-full rounded-xl border-0 bg-white px-4 py-3 text-stone-900 shadow-sm ring-1 ring-stone-200 placeholder:text-stone-400 focus:outline-none focus:ring-2 focus:ring-brand-500"
          />
        </label>
        <label class="block sm:col-span-2">
          <span class="text-sm font-medium text-stone-700">Message</span>
          <textarea
            name="message"
            rows="4"
            placeholder="Tell us a bit about your plans..."
            class="mt-2 w-full rounded-xl border-0 bg-white px-4 py-3 text-stone-900 shadow-sm ring-1 ring-stone-200 placeholder:text-stone-400 focus:outline-none focus:ring-2 focus:ring-brand-500"
          ></textarea>
        </label>
      </div>
      <button
        type="submit"
        class="mt-8 w-full rounded-full bg-brand-600 px-8 py-4 text-base font-semibold text-white shadow-lg shadow-brand-900/20 transition hover:bg-brand-500 sm:w-auto"
      >
        Send request
      </button>
      <p
        id="contact-confirmation"
        class="mt-4 hidden text-sm font-medium text-emerald-600"
      >
        Thanks! We'll be in touch within one business day.
      </p>
    </form>
  </div>
</section>

<script>
  const form = document.getElementById("contact-form");
  const confirmation = document.getElementById("contact-confirmation");

  form?.addEventListener("submit", (event) => {
    event.preventDefault();
    if (form instanceof HTMLFormElement) form.reset();
    confirmation?.classList.remove("hidden");
  });
</script>
