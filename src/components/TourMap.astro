---
import "leaflet/dist/leaflet.css";
import type { RouteStop } from "../data/tours";

interface Props {
  stops: RouteStop[];
  class?: string;
}

const { stops, class: className } = Astro.props;
---

<figure class:list={["reveal", className]}>
  <div
    class="tour-map isolate aspect-[16/10] w-full overflow-hidden rounded-3xl ring-1 ring-stone-200"
    data-stops={JSON.stringify(stops)}
  >
  </div>
  <figcaption class="mt-3 text-sm text-stone-500">
    {stops.map((stop) => stop.name).join(" → ")}
  </figcaption>
</figure>

<style>
  .tour-map {
    font-family: inherit;
  }
</style>

<script>
  import L from "leaflet";
  import type { RouteStop } from "../data/tours";

  // --color-brand-600 in global.css
  const routeColor = "#c95327";

  document.querySelectorAll<HTMLElement>(".tour-map").forEach((element) => {
    const stops: RouteStop[] = JSON.parse(element.dataset.stops ?? "[]");
    const points = stops.map((stop) => L.latLng(stop.lat, stop.lng));

    const map = L.map(element, { scrollWheelZoom: false });
    L.tileLayer("https://tile.openstreetmap.org/{z}/{x}/{y}.png", {
      maxZoom: 18,
      attribution:
        '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors',
    }).addTo(map);

    L.polyline(points, { color: routeColor, weight: 4, dashArray: "8 8" }).addTo(map);
    stops.forEach((stop) => {
      L.circleMarker([stop.lat, stop.lng], {
        radius: 8,
        color: "#fff",
        weight: 3,
        fillColor: routeColor,
        fillOpacity: 1,
      })
        .bindTooltip(stop.name, { permanent: true, direction: "right", offset: [10, 0] })
        .addTo(map);
    });

    map.fitBounds(L.latLngBounds(points), { padding: [48, 48] });
  });
</script>
