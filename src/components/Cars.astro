---
import CarCard from "./CarCard.astro";
import { cars } from "../data/cars";
import { withBase } from "../lib/withBase";
---

<section id="cars" class="bg-white py-24">
  <div class="mx-auto max-w-7xl px-6">
    <div class="reveal max-w-2xl">
      <p
        class="text-sm font-semibold uppercase tracking-[0.25em] text-brand-600"
      >
        Car rental
      </p>
      <h2
        class="mt-3 font-display text-4xl font-semibold text-stone-900 sm:text-5xl"
      >
        Your keys to the open road
      </h2>
      <p class="mt-4 text-lg leading-relaxed text-stone-600">
        4x4s built for Uganda's roads, minivans for the group, self-drive or
        with one of our own drivers behind the wheel. Pick your rate below
        and book straight from WhatsApp.
      </p>
    </div>
    <div
      class="mt-14 grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-3"
    >
      {cars.map((car) => <CarCard car={car} />)}
    </div>
    <a
      href={withBase("/car-rental/")}
      class="reveal mt-10 inline-flex text-sm font-semibold text-brand-600 transition hover:text-brand-500"
    >
      Self-drive requirements and which car suits your route →
    </a>
  </div>
</section>
