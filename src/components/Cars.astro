---
import CarCard from "./CarCard.astro";
import { cars } from "../data/cars";
---

<section id="cars" class="bg-white py-24">
  <div class="mx-auto max-w-7xl px-6">
    <div class="reveal max-w-2xl">
      <p
        class="text-sm font-semibold uppercase tracking-[0.25em] text-brand-600"
      >
        Car rental
      </p>
      <h2
        class="mt-3 font-display text-4xl font-semibold text-stone-900 sm:text-5xl"
      >
        Your keys to the open road
      </h2>
      <p class="mt-4 text-lg leading-relaxed text-stone-600">
        <!-- A modern, fully insured fleet with unlimited mileage and free airport
        pickup on rentals of three days or more. -->
      </p>
    </div>
    <div
      class="mt-14 grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-3"
    >
      {cars.map((car) => <CarCard car={car} />)}
    </div>
  </div>
</section>
