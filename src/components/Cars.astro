---
import CarCard from "./CarCard.astro";
import { cars } from "../data/cars";
---

<section id="cars" class="bg-white py-24">
  <div class="mx-auto max-w-7xl px-6">
    <div class="reveal max-w-2xl">
      <p
        class="text-sm font-semibold uppercase tracking-[0.25em] text-brand-600"
      >
        Car rental
      </p>
      <h2
        class="mt-3 font-display text-4xl font-semibold text-stone-900 sm:text-5xl"
      >
        Your keys to the open road
      </h2>
      <p class="mt-4 text-lg leading-relaxed text-stone-600">
        <!-- A modern, fully insured fleet with unlimited mileage and free airport
        pickup on rentals of three days or more. -->
      </p>
    </div>
    <div
      class="mt-14 grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-3"
    >
      {cars.map((car) => <CarCard car={car} />)}
    </div>
  </div>
</section>

<script>
  const findDialog = (el: HTMLElement) =>
    el.closest("article")?.querySelector<HTMLDialogElement>(
      ".car-gallery-dialog"
    );

  const scrollToSlide = (track: HTMLElement, direction: -1 | 1) => {
    const slideWidth =
      track.firstElementChild instanceof HTMLElement
        ? track.firstElementChild.offsetWidth
        : 0;
    track.scrollBy({ left: direction * slideWidth, behavior: "smooth" });
  };

  document.addEventListener("click", (event) => {
    const target = event.target as HTMLElement;

    const trigger = target.closest<HTMLElement>(".car-gallery-trigger");
    if (trigger) {
      findDialog(trigger)?.showModal();
      return;
    }

    const closeButton = target.closest<HTMLElement>(".car-gallery-close");
    if (closeButton) {
      closeButton.closest("dialog")?.close();
      return;
    }

    const dialog = target.closest<HTMLDialogElement>(".car-gallery-dialog");
    if (dialog && target === dialog) {
      dialog.close();
      return;
    }

    const prevButton = target.closest<HTMLElement>(".car-gallery-prev");
    const nextButton = target.closest<HTMLElement>(".car-gallery-next");
    if (!prevButton && !nextButton) return;

    const track = target
      .closest(".car-gallery-dialog")
      ?.querySelector<HTMLElement>(".car-gallery-track");
    if (track) scrollToSlide(track, prevButton ? -1 : 1);
  });

  document.addEventListener("keydown", (event) => {
    const openDialog = document.querySelector<HTMLDialogElement>(
      ".car-gallery-dialog[open]"
    );
    if (!openDialog || (event.key !== "ArrowLeft" && event.key !== "ArrowRight"))
      return;

    const track = openDialog.querySelector<HTMLElement>(".car-gallery-track");
    if (track) scrollToSlide(track, event.key === "ArrowLeft" ? -1 : 1);
  });
</script>
