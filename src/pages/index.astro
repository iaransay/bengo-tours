---
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import Highlights from "../components/Highlights.astro";
import Tours from "../components/Tours.astro";
import Cars from "../components/Cars.astro";
import Permits from "../components/Permits.astro";
import About from "../components/About.astro";
import Testimonials from "../components/Testimonials.astro";
import Contact from "../components/Contact.astro";
import Footer from "../components/Footer.astro";
import { getImage } from "astro:assets";
import { withBase } from "../lib/withBase";
import logo from "../assets/logo.png";
import safariLandCruiser from "../assets/cars/safari-land-cruiser.jpg";

const siteUrl = new URL(withBase("/"), Astro.site).href;
const logoImage = await getImage({ src: logo, width: 512, format: "png" });
const businessImage = await getImage({
  src: safariLandCruiser,
  width: 1200,
  format: "jpeg",
});

const travelAgency = {
  "@context": "https://schema.org",
  "@type": "TravelAgency",
  "@id": `${siteUrl}#organization`,
  name: "Bengo Tours and Travels",
  alternateName: "Bengo Tours Uganda",
  url: siteUrl,
  logo: new URL(logoImage.src, Astro.site).href,
  image: new URL(businessImage.src, Astro.site).href,
  description:
    "Car rental with or without a driver, safari vehicles and Uganda Wildlife Authority gorilla and chimpanzee permits, based in Kampala, Uganda.",
  telephone: "+256756659419",
  address: {
    "@type": "PostalAddress",
    addressLocality: "Kampala",
    addressCountry: "UG",
  },
  areaServed: { "@type": "Country", name: "Uganda" },
  priceRange: "$$",
};
---

<Base
  title="Car Rental & Gorilla Permits in Uganda | Bengo Tours"
  description="Rent a 4x4 in Uganda with or without a driver, and book gorilla and chimpanzee permits through Bengo Tours, based in Kampala. Message us on WhatsApp for a quote."
  jsonLd={travelAgency}
>
  <Header />
  <main>
    <Hero />
    <Highlights />
    <Tours />
    <Cars />
    <Permits />
    <About />
    <Testimonials />
    <Contact />
  </main>
  <Footer />
</Base>
