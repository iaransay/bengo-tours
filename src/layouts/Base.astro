---
import "../styles/global.css";
import type { ImageMetadata } from "astro";
import { getImage } from "astro:assets";
import { withBase } from "../lib/withBase";
import logo from "../assets/logo.png";
import defaultShareImage from "../assets/cars/safari-land-cruiser.jpg";

interface Props {
  title: string;
  description: string;
  image?: ImageMetadata;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title,
  description,
  image = defaultShareImage,
  jsonLd,
} = Astro.props;

const siteName = "Bengo Tours Uganda";
const canonicalUrl = new URL(Astro.url.pathname, Astro.site).href;

// 1200×630 JPEG is the size and format social previews (WhatsApp, Facebook, X) handle best.
const shareImage = await getImage({
  src: image,
  width: 1200,
  height: 630,
  fit: "cover",
  format: "jpeg",
});
const shareImageUrl = new URL(shareImage.src, Astro.site).href;
const touchIcon = await getImage({ src: logo, width: 180, format: "png" });
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="sitemap" href={withBase("/sitemap-index.xml")} />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#0c0a09" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={shareImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={shareImageUrl} />

    <link rel="icon" href={withBase("/favicon.ico")} sizes="32x32" />
    <link rel="icon" type="image/svg+xml" href={withBase("/favicon.svg")} />
    <link rel="apple-touch-icon" href={touchIcon.src} />
    {
      jsonLd && (
        <script
          type="application/ld+json"
          is:inline
          set:html={JSON.stringify(jsonLd)}
        />
      )
    }
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600;9..144,700&family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <slot />
    <script>
      const revealElements = document.querySelectorAll(".reveal");
      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              entry.target.classList.add("is-visible");
              observer.unobserve(entry.target);
            }
          }
        },
        { threshold: 0.15 }
      );
      revealElements.forEach((el) => observer.observe(el));
    </script>
  </body>
</html>
